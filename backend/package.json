{
  "name": "duo-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API for Duo Tracker",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "test": "cross-env NODE_ENV=test node --test tests/auth.test.js tests/households.test.js tests/password.test.js tests/categories.test.js",
    "dev": "cross-env NODE_ENV=development nodemon src/server.js",
    "dev:prod-db": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed:categories": "node src/utils/seedCategories.js",
    "reset:data": "node src/utils/resetTransactionData.js",
    "change:password": "node src/utils/changePassword.js",
    "backup": "node src/utils/backup.js",
    "restore": "node src/utils/restore.js",
    "verify:backup": "node src/utils/verifyBackup.js",
    "migrate:households": "node src/utils/migrateToHouseholds.js"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
