{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "design": {
      "extends": "preview",
      "channel": "design",
      "env": {
        "APP_VARIANT": "design"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
